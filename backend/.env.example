APP_TITLE=AI Chatbot Platform API
APP_DESCRIPTION=Backend API for AI-powered chatbot with RAG capabilities
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
PUBLIC_APP_URL=http://localhost:5173

# OpenAI / Models
OPENAPI_KEY2=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-ada-002
USE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OUTCOME_CLASSIFICATION_MODEL=gpt-4o-mini

# Outcome daemon
OUTCOME_DAEMON_HOUR_UTC=2
OUTCOME_DAEMON_MINUTE_UTC=15
OUTCOME_DAEMON_INITIAL_DELAY_SECONDS=30
OUTCOME_DAEMON_BATCH_SIZE=100
OUTCOME_DAEMON_MAX_BATCHES=20

# WhatsApp / Meta
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_REDIRECT_URI=
WHATSAPP_GRAPH_VERSION=v21.0
DEV_BYPASS_SUBSCRIPTION_CHECK=false

# Chat escalation defaults
DEFAULT_ESCALATION_CONTACT_LEVEL_1=Support Team: Vaishnavi Khedekar | vaishnavi.khedekar@zentrixel.com | +91-7507209201
DEFAULT_ESCALATION_CONTACT_LEVEL_2=Escalation Manager: Chiranjibi Das | chiranjibi.das@zentrixel.com | +91-9764013221
HUMAN_HANDOFF_DISTANCE_THRESHOLD=0.65
HUMAN_HANDOFF_NO_ANSWER_PATTERNS=i don't know|i do not know|don't have a reliable answer|unable to answer|no relevant context found|knowledge base doesn't contain|don't have reliable expertise|escalation contacts|would you like me to connect you
HUMAN_HANDOFF_WAITING_MESSAGE=I am connecting you to a human expert. Please share any additional details and we will respond shortly.
HUMAN_HANDOFF_WAIT_TIMEOUT_SECONDS=120
HUMAN_HANDOFF_MAX_WAIT_CYCLES=2
HUMAN_HANDOFF_BUSY_MESSAGE=Live users are currently busy. Do you want to wait for 2 more minutes while I try again, or would you like to schedule a meeting and I will set it up for you?
HUMAN_HANDOFF_FINAL_TIMEOUT_MESSAGE=Live users are still busy, so I am moving you back to the bot. I can help you set up a meeting now, or you can type exit to end this chat session.

# Reporting token-cost rates
TOKEN_COST_PROMPT_PER_1K=0.03
TOKEN_COST_COMPLETION_PER_1K=0.06

# Storage
DATABASE_URL=sqlite:///./chatbot.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_FILE_SIZE_MB=10
MAX_TOTAL_UPLOAD_SIZE_MB=50

# Database pool tuning (Postgres)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080
TEST_LINK_EXPIRY_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5500,https://thomasina-mesogleal-alarmingly.ngrok-free.dev,https://zentrixel-it-services.myshopify.com,http://aibot.zentrixel.com,https://aibot.zentrixel.com,http://api-aibot.zentrixel.com,https://api-aibot.zentrixel.com
CORS_ALLOW_ORIGIN_REGEX=https://.*\.myshopify\.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Email SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=25
SMTP_USERNAME=smtp@sales-arm.com
SMTP_PASSWORD=Salesarm@1
SMTP_USE_SSL=false
EMAIL_SENDER=noreply@sales-arm.com 
CAMPAIGN_EMAIL_RCPT_CHECK=true
CAMPAIGN_EMAIL_RCPT_CHECK_TIMEOUT_SECONDS=10
FRONTEND_DASHBOARD_LEADS_URL=http://localhost:5173/leads

TWILIO_SMS_DEFAULT_ACCOUNT_SID=
TWILIO_SMS_DEFAULT_AUTH_TOKEN=
TWILIO_SMS_DEFAULT_FROM_NUMBER=
TWILIO_SMS_DEFAULT_INBOUND_NUMBER=
TWILIO_SMS_DEFAULT_LOCATION_LABEL=
TWILIO_SMS_DEFAULT_VOICE_WEBHOOK_URL=
TWILIO_SMS_DEFAULT_MESSAGING_WEBHOOK_URL=


