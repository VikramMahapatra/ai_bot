APP_TITLE=AI Chatbot Platform API
APP_DESCRIPTION=Backend API for AI-powered chatbot with RAG capabilities
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# OpenAI / Models
OPENAPI_KEY2=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-ada-002
USE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OUTCOME_CLASSIFICATION_MODEL=gpt-4o-mini

# Outcome daemon
OUTCOME_DAEMON_HOUR_UTC=2
OUTCOME_DAEMON_MINUTE_UTC=15
OUTCOME_DAEMON_INITIAL_DELAY_SECONDS=30
OUTCOME_DAEMON_BATCH_SIZE=100
OUTCOME_DAEMON_MAX_BATCHES=20

# WhatsApp / Meta
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
DEV_BYPASS_SUBSCRIPTION_CHECK=false

# Chat escalation defaults
DEFAULT_ESCALATION_CONTACT_LEVEL_1=Support Team: support@example.com | +1-555-0101
DEFAULT_ESCALATION_CONTACT_LEVEL_2=Escalation Manager: escalation@example.com | +1-555-0102

# Reporting token-cost rates
TOKEN_COST_PROMPT_PER_1K=0.03
TOKEN_COST_COMPLETION_PER_1K=0.06

# Storage
DATABASE_URL=sqlite:///./chatbot.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5500
CORS_ALLOW_ORIGIN_REGEX=https://.*\.myshopify\.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Email SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=25
SMTP_USERNAME=smtp@example.com
SMTP_PASSWORD=change-me
SMTP_USE_SSL=false
EMAIL_SENDER=noreply@example.com
CAMPAIGN_EMAIL_RCPT_CHECK=true
CAMPAIGN_EMAIL_RCPT_CHECK_TIMEOUT_SECONDS=10
FRONTEND_DASHBOARD_LEADS_URL=http://localhost:5173/leads
